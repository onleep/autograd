# MySQL database name
DB_NAME=autograd
# MySQL root password
DB_PASS=
# Database address in host:port format
DB_ADDR=mysql:3306

# MinIO access key|login
S3_ID=autograd
# MinIO secret key|password
S3_KEY=
# S3 endpoint
S3_ADDR=http://minio:9000

# Grafana administrator login
GF_NAME=autograd
# Grafana administrator password
GF_PASS=

# Base domain without protocol (example.com); required for Caddy in compose.yml
DOMAIN=

# http://user:pass@host:port | IPv6 / IPv4 proxies for parser; you can specify PROXY0..PROXY99; at least one proxy is required
PROXY0=
PROXY1=

# ML mode: 0 off, 1 preprocess only, 2 preprocess + train, 3 train only
ML_MODE=0
# Training mode: 0 - without description or photo features, 1 - CatBoost description processing, 2 - embedding description, 3 - embedding description & photo features, 4 - photo features
TRAIN_MODE=0
# price or predicted_price
TRAIN_TARGET=price
# VLM address
VLM_URL=http://vlm:8000/v1/chat/completions
# VLM model name from HF
VLM_MODEL=Qwen/Qwen3-VL-4B-Instruct-FP8

# Model file name in MinIO (model_2026-03-24_0.96.cbm), expected path is main/data/<API_MODEL>
API_MODEL=
# Prediction API address used by the frontend
API_ADDR=http://api:8000/predict
